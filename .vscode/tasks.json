{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LocalStack Start",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/localstack-setup.sh"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*",
          "endsPattern": "^.*Ready\\."
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "LocalStack Stop",
      "type": "shell",
      "command": "localstack",
      "args": ["stop"],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
